# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES
# Được đọc tự động bởi `next build` khi build Docker image.
# NEXT_PUBLIC_* được bake vào JS bundle tại build time.
# ============================================================

# URL của Kong API Gateway (trình duyệt dùng để gọi API)
# Thay bằng domain API của bạn nếu khác.
NEXT_PUBLIC_API_URL=https://api.dangcapnhatvietnam.site

# WebSocket notifications (dùng wss:// vì frontend là HTTPS)
NEXT_PUBLIC_NOTIFICATION_WS_URL=wss://api.dangcapnhatvietnam.site/ws/notifications
NEXT_PUBLIC_NOTIFICATION_WS_ENABLED=true

# WebSocket real-time board drag-and-drop
NEXT_PUBLIC_WS_URL=wss://api.dangcapnhatvietnam.site/ws/boards
NEXT_PUBLIC_REALTIME_ENABLED=true
